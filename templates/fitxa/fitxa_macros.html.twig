{% macro kanalaMargoztu(kanalmota, kanal, locale) %}
   {# {{ dump(kanalmota, kanal, locale) }} #}
   {% if locale == 'eu' %}
      {% set mota = kanalmota.motaeu %}
      {% set deskribapena = kanal.deskribapenaeu | default('') %}
      {% set izena = kanal.izenaeu | default('') %}
      {% set esteka = kanal.estekaeu | default('') %}
      {% set udala = fitxa.udala.izenaeu | default('') %}
   {% else %}
      {% set mota =  kanalmota.motaes %}
      {% set deskribapena = kanal.deskribapenaes | default('') %}
      {% set izena = kanal.izenaes | default('') %}
      {% set esteka = kanal.estekaes | default('') %}
      {% set udala = fitxa.udala.izenaes | default('') %}
   {% endif %}
   
    <table style="margin-top: 10px;">
      <tr class="mt-1 mb-1">
            <td>
                <b>{{ 'messages.aukera' | trans }}:&nbsp;{{ mota }}</b>
            </td>
      </tr>
      {# Telematikoa #}
      {% if kanal.telematikoa %}
            {# <ul class="mt-1">
               <li>{{ deskribapena }}</li>
            </ul> #}
            {% if esteka != '' %}
                <tr>
                    <td>
                        <a href="{{esteka}}" title="{{ 'messages.izapideaHasi' | trans }}" alt="{{ 'messages.izapideaHasi' | trans }}" target="_blank">{{ 'messages.izapideaHasi' | trans }}</a>
                    </td>
                </tr>
            {% endif %}

      {# Aurrez-Aurrekoa #}
      {% elseif kanalmota.id == 1 %}
         {% if esteka %}
               <tr class="mb-1">
                    <td>
                        {% if izena %}
                            <ul class="mt-1">
                                {% if izena %}<li>{{ izena }}:</li>{% endif %}
                                {% if deskribapena %}<li>{{ deskribapena }}</li>{% endif %}
                            </ul>
                        {% endif %}
                        <b>{{ 'messages.kokapena' | trans  }}:</b>
                        {% if kanal.eraikina %}{{ kanal.eraikina.izena }}&nbsp;-&nbsp;{% endif %}
                        {% if kanal.kalea %}{{ kanal.kalea }}{% endif %}{% if kanal.kalezbkia %}&nbsp;{{ kanal.kalezbkia }}, {% endif %}
                        {% if kanal.postakodea %}{{ kanal.postakodea }} {{ udala }}{% endif %}
                        {% if '@' in esteka and 'maps' not in esteka %}
                            <a class="underline" href='mailto:{{ esteka }}'>{{ izena }}</a>
                        {% else %}
                            <a class="underline" href="{{ esteka }}" target="_blank" title="{{ 'messages.kokapenaIkusi' | trans }}" alt="{{ 'messages.kokapenaIkusi' | trans }}">{{ 'messages.kokapenaIkusi' | trans }}</a><br>
                        {% endif %}
                        {% if kanal.ordutegia %}<b>{{ 'messages.ordutegia' | trans }}:</b> {{ kanal.ordutegia }}{% endif %}
                        {% if kanal.telefonoa %}{{ kanal.telefonoa }}{% endif %}
                        {% if kanal.fax %}Faxa: {{ kanal.fax }}{% endif %}
                    </td>
               </tr>
         {% endif %}
      {# Posta elektronikoa #}
      {% elseif kanalmota.id == 3 %}
            <tr>
                <td>
                    <a class="underline" href='mailto:{{ esteka }}'>{{ izena }}</a>
                </td>
            </tr>
      {% elseif kanalmota.id == 2 %}
            <tr>
                <td>
                    <a class="underline" href='tel:{{ kanal.telefonoa }}'>{{ kanal.telefonoa }}</a>
                </td>
            </tr>
      {% else %}
        <tr>
            <td>
                <p>{{ deskribapena }}</p>
            </td>
        </tr>        
      {% endif %}
   </table>
{% endmacro %}

{% macro bilingualKanalSection(labelEU, labelES, textEU, textES, kanalmotak, kanalak, zerbitzua, udala, parametroa, showText, showTable, locale) %}
    <table cellspacing="0" cellpadding="4">
        <tr>
            <td>
                <h4>{{ locale == 'eu' ? labelEU : labelES }}</h4>
            </td>
        </tr>
        <tr>
            <td style="font-size: small;">
                {% if showTable %}
                    {% for k in kanalmotak %}
                        {% for kanal in kanalak %}
                            {% if kanal.kanalmota == k and kanal.erakutsi == 1 %}
                                {% set kanalmota = kanal.kanalmota %}
                                {{ _self.kanalaMargoztu(kanalmota, kanal, locale) }}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                {% endif %}
                {% if showText %}
                    {{ (locale == 'eu' ? textEU : textES) | raw }}
                {% endif %}
            </td>
        </tr>
    </table>
{% endmacro %}
