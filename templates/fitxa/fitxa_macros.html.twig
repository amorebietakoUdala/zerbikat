{% macro bilingualAraudiaSection(labelEU, labelES, textEU, textES, araudiak, showText, showTable, locale) %}
    <table cellspacing="0" cellpadding="4">
        <tr>
            <td>
                <h4>{{ locale == 'eu' ? labelEU : labelES }}</h4>
            </td>
        </tr>
        <tr>
            <td style="font-size: small;">
                {% set kont = 0 %}
                {% if showText %}
                    {{ (locale == 'eu' ? textEU : textES) | raw }}
                {% endif %}

                {% if showTable and araudiak|length > 0 %}
                    <ul>
                        {% for araua in araudiak %}
                            {% set link = locale == 'eu' ? araua.araudia.estekaeu : araua.araudia.estekaes %}
                            {% set title = locale == 'eu' ? araua.araudia.arauaeu : araua.araudia.arauaes %}
                            {% set section = locale == 'eu' ? araua.atalaeu : araua.atalaes %}
                            <li>
                                {% if link is defined and link %}
                                    <a href="{{ link }}">{{ title }}</a>
                                {% else %}
                                    {{ title }}
                                {% endif %}
                                {% if section %} - {{ section }}{% endif %}
                            </li>
                            {% set kont = kont + 1 %}
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if kont == 0 and (locale == 'eu' ? textEU is empty : textES is empty) %}
                    {{ locale == 'eu' ? 'Ez dagokio' : 'No corresponde' }}
                {% endif %}
            </td>
        </tr>
    </table>
{% endmacro %}

