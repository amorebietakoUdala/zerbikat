{% macro bilingualKostuaSection(labelEU, labelES, doanLabelEU, doanLabelES, showText, showTable, fitxa, kostuZerrenda, locale) %}
    <table cellspacing="0" cellpadding="4">
        <tr>
            <td>
                <h4>{{ locale == 'eu' ? labelEU : labelES }}</h4>
            </td>
        </tr>
        <tr>
            <td style="font-size: small;">
                {% set kont = 0 %}
                {% if showTable %}
                    {% if fitxa.udala.zergaor %}
                        {% for kostutaula in kostuZerrenda %}
                            <table border="1" cellspacing="0" cellpadding="4" width="90%">
                                <tr>
                                    <td colspan="12" class="text-center">
                                        {{ kostutaula['kodea_prod'] }} - {{ kostutaula['izenburua'~locale~'_prod'] }}
                                    </td>
                                </tr>
                                {% for parrafo in kostutaula['parrafoak'] %}
                                    <tr>
                                        <td colspan="12">
                                            {% if parrafo['testua'~locale~'_prod'] %}
                                                {{ parrafo['testua'~locale~'_prod'] | raw }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}

                                {% for kontzeptu in kostutaula['kontzeptuak'] %}
                                    <tr>
                                        <td colspan="9">
                                            {{ kontzeptu['kontzeptua'~locale~'_prod'] is defined ? kontzeptu['kontzeptua'~locale~'_prod'] : '' }}
                                        </td>
                                        <td NOWRAP colspan="3">
                                            {% if kontzeptu['kopurua_prod'] is defined %}
                                                {{ kontzeptu['kopurua_prod'] }}
                                            {% endif %}
                                            {% if kontzeptu['unitatea_prod'] is defined %}
                                                {{ kontzeptu['unitatea_prod'] }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                            <p>&nbsp;</p>
                            {% set kont = kont + 1 %}
                        {% endfor %}
                    {% else %}
                        {% for azpiatal in fitxa.azpiatalak %}
                            <table border="1" cellspacing="0" cellpadding="4" width="90%">
                                <tr>
                                    <td colspan="12" style="font-size: small;"><b>
                                            {{ azpiatal.atala.ordenantza.kodea }}.{{ azpiatal.atala.kodea }}.{{ azpiatal.kodea }}-
                                            {{ locale == 'eu' ? azpiatal.izenburuaeu : azpiatal.izenburuaes }}</b>
                                    </td>
                                </tr>
                                {% for parrafo in azpiatal.parrafoak %}
                                    <tr>
                                        <td colspan="12" style="font-size: small;">{{ parrafo.testua }} </td>
                                    </tr>
                                {% endfor %}

                                {% for kontzeptu in azpiatal.kontzeptuak %}
                                    <tr>
                                        <td colspan="9" style="font-size: small;">
                                            {{ locale == 'eu' ? kontzeptu.kontzeptuaeu : kontzeptu.kontzeptuaes }}
                                            {% if kontzeptu.baldintza %}
                                                ({{ locale == 'eu' ? kontzeptu.baldintza.baldintzaeu : kontzeptu.baldintza.baldintzaes }})
                                            {% endif %}
                                        </td>
                                        <td colspan="3" style="font-size: small;">
                                            {{ kontzeptu.kopurua }} {{ kontzeptu.unitatea }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                            {% set kont = kont + 1 %}
                        {% endfor %}
                    {% endif %}
                {% endif %}
                {% if showText %}
                    {{ locale == 'eu' ? fitxa.kostuaeu | raw : fitxa.kostuaes | raw }}
                {% endif %}
                {% if ((locale == 'eu' and fitxa.kostuaeu is empty) or (locale != 'eu' and fitxa.kostuaes is empty)) and kont == 0 %}
                    {{ locale == 'eu' ? doanLabelEU : doanLabelES }}
                {% endif %}
            </td>
        </tr>
    </table>
{% endmacro %}

