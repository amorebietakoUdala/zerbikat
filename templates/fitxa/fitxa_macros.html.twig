                        {{ labelak.isiltasunadminlabeleu }}: {{ fitxa.isiltasunadmin }}
                    {% else %}
                        {{ labelak.isiltasunadminlabeles }}: {{ fitxa.isiltasunadmin.isiltasunes }}
                    {% endif %}
                {% endif %}
