{% macro pdfHeaderSection(fitxa, locale) %}
    <table border="1" cellpadding="4">
        <tr>
            <td colspan="12" style="text-align:right">
                {% if fitxa.updatedAt %}
                    <span style="font-size: small;">{{ 'message.azkenEguneraketa' | trans }} {{ fitxa.updatedAt|date('Y-m-d H:i:s') }}</span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <img src="{{ fitxa.udala.logoa }}"/>
                <h6 style="text-align:center">
                    {{ locale == 'eu' ? fitxa.udala.izendapenaeu : fitxa.udala.izendapenaes }}
                </h6>
                <h6 style="text-align:center">{{ fitxa.udala.ifk }}</h6>
            </td>
            <td colspan="2"><h2>{{ fitxa.espedientekodea }}</h2></td>
            <td colspan="8">
                <h5>{{ locale == 'eu' ? fitxa.deskribapenaeu : fitxa.deskribapenaes }}</h5>
            </td>
        </tr>
    </table>
{% endmacro %}

{% macro bilingualDatuenBabesSection(labelEU, labelES, udala, datuenbabesa, textEU, textES, showText, showTable, locale) %}
    <table cellspacing="0" cellpadding="4">
        <tr>
            <td>
                <h4>{{ locale == 'eu' ? labelEU : labelES }}</h4>
            </td>
        </tr>
        <tr>
            <td style="font-size: xx-small;">
                {% if showTable and datuenbabesa %}
                    {{ (locale == 'eu' ? udala.lopdeu : udala.lopdes)
                        |replace({ ('$$$fitxa.datuenbabesa.izena' ~ (locale == 'eu' ? 'eu' : 'es') ~ '$$$'): datuenbabesa['izena' ~ (locale == 'eu' ? 'eu' : 'es')] })
                        |replace({ ('$$$fitxa.datuenbabesa.kodea$$$'): datuenbabesa.kodea })
                        |replace({ ('$$$fitxa.datuenbabesa.xedea' ~ (locale == 'eu' ? 'eu' : 'es') ~ '$$$'): datuenbabesa['xedea' ~ (locale == 'eu' ? 'eu' : 'es')] })
                        |replace({ ('$$$fitxa.datuenbabesa.lagapenak' ~ (locale == 'eu' ? 'eu' : 'es') ~ '$$$'): datuenbabesa['lagapenak' ~ (locale == 'eu' ? 'eu' : 'es')] })
                        |raw }}
                {% endif %}
                {% if showText %}
                    {{ (locale == 'eu' ? textEU : textES) | raw }}
                {% endif %}
            </td>
        </tr>
    </table>
{% endmacro %}

{% macro bilingualListSection(labelEU, labelES, textEU, textES, items, itemFieldEU, itemFieldES, showText, showTable, locale) %}
    <table cellspacing="0" cellpadding="4">
        <tr>
            <td>
                <h4>{{ locale == 'eu' ? labelEU : labelES }}</h4>
            </td>
        </tr>
        <tr>
            <td style="font-size: small;">
                {% if showText %}
                    {{ (locale == 'eu' ? textEU : textES) | raw }}
                {% endif %}
                {% if showTable %}
                    <ul>
                        {% for item in items %}
                            <li>{{ attribute(item, locale == 'eu' ? itemFieldEU : itemFieldES) }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </td>
        </tr>
    </table>
{% endmacro %}

